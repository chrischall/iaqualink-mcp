{
  "mcpServers": {
    "iaqualink": {
      "command": "npx",
      "args": ["-y", "@chrischall/iaqualink-mcp"],
      "env": {
        "IAQUALINK_EMAIL": "${IAQUALINK_EMAIL}",
        "IAQUALINK_PASSWORD": "${IAQUALINK_PASSWORD}",
        "IAQUALINK_STATUS_CACHE_SECONDS": "${IAQUALINK_STATUS_CACHE_SECONDS}",
        "IAQUALINK_WEBTOUCH_STREAM_HOSTS": "${IAQUALINK_WEBTOUCH_STREAM_HOSTS}"
      }
    }
  }
}
